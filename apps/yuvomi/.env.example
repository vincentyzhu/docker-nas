# 复制为 .env。每个实例使用不同的项目名和宿主机端口。
COMPOSE_PROJECT_NAME=yuvomi
YUVOMI_BIND_IP=127.0.0.1
YUVOMI_HOST_PORT=3000
TZ=Asia/Shanghai

# 使用局域网访问或 HTTPS 反代时，将 BASE_URL 改为浏览器使用的完整地址。
BASE_URL=http://127.0.0.1:3000
# 单层 HTTPS 反代通常使用 SESSION_SECURE=true 和 TRUST_PROXY=1。
SESSION_SECURE=false
TRUST_PROXY=loopback

# 新实例可留空，应用会将自动生成的密钥保存在 data/.secrets。
# 已通过环境变量提供密钥的实例迁移时，填回原值。
SESSION_SECRET=
DB_ENCRYPTION_KEY=

# 启用后将上传文档写入当前实例的 ./documents。
DOCUMENT_STORAGE_LOCAL_ENABLED=false
