# 复制为 .env。为六项分别生成随机值，保留原值并随数据备份。
# DATABASE_DECRYPTION_KEY 使用 32 个 ASCII 字符，其余可用 64 个十六进制字符。
PG_PASSWORD=
PG_ENCRYPTION_KEY=
DATABASE_DECRYPTION_KEY=
CONFIG_ENCRYPTION_KEY=
JWT_KEY=
SETUP_TOKEN=

# 仅发布 Web 端口，默认监听宿主机回环。
MIROBODY_BIND_IP=127.0.0.1
MIROBODY_HOST_PORT=18060

# 按需填写 MCP 的 HTTPS 入口和应用信任的反代来源 IP。
MCP_PUBLIC_URL=
FORWARDED_ALLOW_IPS=127.0.0.1
