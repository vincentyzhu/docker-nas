# 复制为 .env 后填写；.env 已被 Git 忽略，不要提交真实密钥。

# 钉钉自定义机器人 Webhook 与加签密钥
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 可选：发送失败时的总尝试次数和间隔秒数
DINGTALK_MAX_ATTEMPTS=3
DINGTALK_RETRY_DELAY_SECONDS=5

# WUD Web 登录（沿用 Basic Auth）。
WUD_BASIC_USER=
# 填写 htpasswd 哈希；哈希通常包含 $，必须使用单引号避免 Compose 再插值。
WUD_BASIC_HASH=''

# SMTP 可选配置；仅在 docker-compose.yml 中启用 SMTP 段落时填写。
WUD_SMTP_USER=
WUD_SMTP_PASS=
WUD_SMTP_FROM=
WUD_SMTP_TO=
