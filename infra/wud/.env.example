# 复制为 .env 后填写；.env 已被 Git 忽略，不要提交真实密钥。

# 机器人通知通道：dingtalk（钉钉）或 wecom（企业微信）
NOTIFY_CHANNEL=dingtalk

# 钉钉自定义机器人；不使用钉钉时可留空。
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
DINGTALK_MAX_ATTEMPTS=3
DINGTALK_RETRY_DELAY_SECONDS=5

# 企业微信群机器人；不使用企业微信时可留空。
WECOM_WEBHOOK=
WECOM_MAX_ATTEMPTS=3
WECOM_RETRY_DELAY_SECONDS=5

# WUD 9.x 管理员登录；用户名和密码均须填写。
WUD_AUTH_ADMIN_USER=
# 填写实际登录密码；WUD 会自动哈希后存入数据库。
# 保留单引号，避免密码中的 $ 被 Compose 插值；密码不要包含冒号 :。
WUD_AUTH_ADMIN_PASSWORD=''

# SMTP 可选配置；仅在 docker-compose.yml 中启用 SMTP 段落时填写。
WUD_SMTP_USER=
WUD_SMTP_PASS=
WUD_SMTP_FROM=
WUD_SMTP_TO=
